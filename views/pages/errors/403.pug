doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="theme-color", content="#0b1020")
    meta(name="description", content="Bạn không có quyền truy cập trang này.")
    title 403 — Không có quyền truy cập | NewsGame
    link(rel="stylesheet", href="/css/error-pages.css")
  body.error-body.error-403
    .ambient.ambient-one(aria-hidden="true")
    .ambient.ambient-two(aria-hidden="true")
    .page-shell
      header.error-header
        a.brand(href="/", aria-label="NewsGame - Trang chủ")
          span.brand-mark NG
          span.brand-name NEWS#[span GAME]
        span.header-label SYSTEM MESSAGE
      main.error-layout
        section.error-copy
          .status-pill
            span.status-dot
            | ACCESS RESTRICTED
          p.error-kicker LỖI TRUY CẬP / 01
          h1 Bạn chưa được #[span cấp quyền.]
          p.error-description
            | Khu vực này chỉ dành cho những tài khoản được cấp quyền phù hợp. Có thể bạn chưa đăng nhập hoặc tài khoản hiện tại không đủ quyền truy cập.
          .error-actions
            a.btn.btn-primary(href="/")
              span.btn-icon ⌂
              | Về trang chủ
            button.btn.btn-ghost(type="button", onclick="history.back()") Quay lại
          p.error-help Mã lỗi: #[strong 403] #[span •] Forbidden
        section.error-visual(aria-label="Minh họa khu vực bị khóa")
          .visual-grid(aria-hidden="true")
          .visual-corner.corner-tl
          .visual-corner.corner-br
          .lock-panel
            .panel-topline
              span.panel-label SECURITY GATE
              span.panel-live LIVE
            .lock-illustration(aria-hidden="true")
              .lock-shackle
              .lock-body
                span.lock-hole
            .lock-scanline
            p.lock-caption ACCESS DENIED
            .panel-bottomline
              span SYSTEM: NEWSGAME
              span CODE 403
      footer.error-footer
        span © 2026 NewsGame
        span.error-footer-note KEEP PLAYING. KEEP EXPLORING.
